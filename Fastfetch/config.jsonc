{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
  "type": "kitty",
  "source": "/home/tipim/Downloads/Eterna.png",
  "width": 22,
  "height": 10,
  "padding": {
    "top": 0,
    "right": 3
  }
},
  "display": {
    "separator": " ➔ ",
    "key": {
      "width": 3
    },
    "color": {
      "keys": "blue",       // Swaps with the font color
      "output": "white",     // Makes it readable
      "separator": "blue"   // Matches with icons
    }
  },
  "modules": [
    { "type": "os", "key": "" },
    { "type": "uptime", "key": "" },
    { "type": "wm", "key": "" },
    { "type": "cpu", "key": "" },
    { "type": "gpu", "key": "" },
    { "type": "memory", "key": "" },
    { "type": "disk", "key": "" }
  ]
}
